# baodou .gitignore

# --- Model weights (large binaries; keep README / small metadata if needed) ---
*.gguf
*.ggufi
model/**
!model/README.md
!model/configuration.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
ENV/
env/

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets / local env ---
.env
.env.local
.env.*.local

# --- Logs & temp ---
logs/
*.log
*.tmp
*.temp
*.bak

# --- Runtime artifacts (benchmarks keep small JSON via negation if needed) ---
artifacts/
**/artifacts/
benchmarks/**/results/*.png
benchmarks/**/results/*.txt

# Conda env exports (optional local)
conda-envs/
